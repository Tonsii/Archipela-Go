<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Archipela Go!</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="design.css">
    <script src="java.js" defer></script>
</head>
<body>

    <header class="header">
        <div class="header-container">
            <a href="#home" class="brand">
                <div class="logo-badge">
                    <span class="logo-arc">ARCHIPELA GO!</span>
                    <span class="logo-dot"></span>
                </div>
                <span class="brand-title">ARCHIPELA GO!</span>
            </a>

            <nav class="main-nav">
                <ul>
                    <li><a href="#home" class="active">HOME</a></li>
                    <li><a href="#destinations">DESTINATIONS</a></li>
                    <li><a href="#about">ABOUT</a></li>
                    <li><a href="#contact">CONTACT</a></li>
                </ul>
            </nav>

            <div class="header-actions">
                <form class="search-box" role="search">
                    <input type="text" placeholder="Where do you want to go?" aria-label="Where do you want to go?">
                    <button type="submit" aria-label="Search">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
                            <circle cx="11" cy="11" r="7"></circle>
                            <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
                        </svg>
                    </button>
                </form>

                <div class="icon-group">
                  
                    <button type="button" class="icon-btn" aria-label="Notifications">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                            <path d="M12 22a2.5 2.5 0 0 0 2.45-2h-4.9A2.5 2.5 0 0 0 12 22zm6.5-6v-5a6.5 6.5 0 0 0-5-6.32V4a1.5 1.5 0 0 0-3 0v.68A6.5 6.5 0 0 0 5.5 11v5L4 17.5v.5h16v-.5L18.5 16z"/>
                        </svg>
                    </button>
              
                    <button type="button" class="icon-btn" aria-label="Profile">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                            <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 3.5a3.2 3.2 0 1 1-3.2 3.2A3.2 3.2 0 0 1 12 5.5zm0 14.2a7.5 7.5 0 0 1-5.8-2.75c.03-1.92 3.87-2.97 5.8-2.97s5.77 1.05 5.8 2.97A7.5 7.5 0 0 1 12 19.7z"/>
                        </svg>
                    </button>
                    
                    <button type="button" class="icon-btn" aria-label="Menu">
                        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <main>
        <section id="home" class="home" style="background-image: url('https://i.pinimg.com/1200x/8d/4e/dc/8d4edcdb957398dff3d90dfcd396c3b3.jpg');">
            <div class="hero-content">
                <h1>Discover the Beauty of the Philippines</h1>
                <p class="hero-subtext">Explore hidden gems, pristine beaches, and vibrant cultures across the islands.</p>
                <a href="#destinations" class="btn">Start Your Journey</a>
                <a href="#about" class="btn btn-secondary">Learn More</a>
            </div>
            <div class="island-carousel" aria-label="Featured Philippine destinations">
            <div class="carousel-card">
                <img
                    id="carouselImage"
                    src="https://i.pinimg.com/1200x/b9/f8/36/b9f8365ca4d3404a043894879cfcb386.jpg"
                    alt="Banaue Rice Terraces in Luzon"
                >

                <div class="carousel-overlay">
                    <span class="carousel-badge" id="carouselRegion">LUZON</span>
                    <h3 class="carousel-title" id="carouselTitle">Banaue Rice Terraces</h3>
                    <p class="carousel-desc" id="carouselDesc">Ifugao, Northern Luzon</p>
                </div>

                <button type="button" class="carousel-arrow prev-arrow" id="prevSlide" aria-label="Previous destination">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                </button>

                <button type="button" class="carousel-arrow next-arrow" id="nextSlide" aria-label="Next destination">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </button>

                <div class="carousel-dots" id="carouselDots"></div>
            </div>
        </div>
    </div>
        </section>

       <section id="destinations" class="explore-section">
            <div class="pill-heading">
                <h2>EXPLORE ISLANDS</h2>
            </div>

            <div class="map-wrapper">
                <!-- Stylized Philippines Archipelago Map -->
                <svg class="ph-map" viewBox="0 0 360 460" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Map of the Philippines showing Luzon, Visayas, and Mindanao">
                    <defs>
                        <filter id="mapShadow" x="-15%" y="-15%" width="130%" height="130%">
                            <feDropShadow dx="2" dy="4" stdDeviation="3" flood-color="#1e293b" flood-opacity="0.28"/>
                        </filter>
                    </defs>

                    <g filter="url(#mapShadow)">
                        <!-- LUZON (Deep Teal) -->
                        <g class="region-luzon" fill="#008073">
                            <!-- Northern & Central Luzon -->
                            <path d="M132,38 L154,36 L163,68 L172,115 L155,148 L167,165 L194,178 L205,196 L185,202 L166,184 L147,188 L136,166 L122,158 L118,125 L127,82 Z"/>
                            <!-- Batanes / Babuyan -->
                            <circle cx="145" cy="14" r="3"/>
                            <circle cx="141" cy="24" r="3.5"/>
                            <circle cx="152" cy="26" r="2.5"/>
                            <!-- Mindoro -->
                            <path d="M124,196 L142,202 L146,228 L130,224 Z"/>
                            <!-- Palawan -->
                            <path d="M98,255 L110,263 L64,335 L52,328 Z"/>
                            <circle cx="114" cy="246" r="3"/>
                            <circle cx="44" cy="343" r="3.5"/>
                        </g>

                        <!-- VISAYAS (Soft Seafoam Mint) -->
                        <g class="region-visayas" fill="#a2d5ba">
                            <!-- Panay -->
                            <path d="M156,232 L177,230 L179,254 L158,258 Z"/>
                            <!-- Negros -->
                            <path d="M182,256 L195,254 L193,292 L179,288 Z"/>
                            <!-- Cebu -->
                            <path d="M202,252 L211,252 L205,290 L198,288 Z"/>
                            <!-- Bohol -->
                            <path d="M214,274 L232,274 L230,289 L213,288 Z"/>
                            <!-- Leyte -->
                            <path d="M234,238 L247,242 L246,275 L235,272 Z"/>
                            <!-- Samar -->
                            <path d="M242,204 L268,208 L266,240 L246,236 Z"/>
                            <!-- Masbate -->
                            <path d="M204,205 L222,216 L216,228 L200,218 Z"/>
                        </g>

                        <!-- MINDANAO (Slate Blue-Grey) -->
                        <g class="region-mindanao" fill="#77959e">
                            <!-- Mainland Mindanao & Zamboanga -->
                            <path d="M218,304 L274,296 L284,332 L274,376 L248,388 L234,372 L212,366 L198,354 L172,365 L165,355 L194,336 L208,324 Z"/>
                            <!-- Sulu Archipelago -->
                            <circle cx="152" cy="374" r="4"/>
                            <circle cx="138" cy="383" r="4.5"/>
                            <circle cx="122" cy="393" r="4"/>
                            <circle cx="108" cy="401" r="3"/>
                        </g>
                    </g>

                    <!-- Map Pin: LUZON -->
                    <g class="map-pin" transform="translate(132, 92)">
                        <path d="M0,-26 C-9,-26 -16,-19 -16,-10 C-16,2 0,18 0,18 C0,18 16,2 16,-10 C16,-19 9,-26 0,-26 Z" fill="#0f292a"/>
                        <circle cx="0" cy="-10" r="6" fill="#e8c7a8"/>
                    </g>

                    <!-- Map Pin: VISAYAS -->
                    <g class="map-pin" transform="translate(230, 232)">
                        <path d="M0,-26 C-9,-26 -16,-19 -16,-10 C-16,2 0,18 0,18 C0,18 16,2 16,-10 C16,-19 9,-26 0,-26 Z" fill="#0f292a"/>
                        <circle cx="0" cy="-10" r="6" fill="#e8c7a8"/>
                    </g>

                    <!-- Map Pin: MINDANAO -->
                    <g class="map-pin" transform="translate(178, 344)">
                        <path d="M0,-26 C-9,-26 -16,-19 -16,-10 C-16,2 0,18 0,18 C0,18 16,2 16,-10 C16,-19 9,-26 0,-26 Z" fill="#0f292a"/>
                        <circle cx="0" cy="-10" r="6" fill="#e8c7a8"/>
                    </g>
                </svg>

                <!-- Region Labels -->
                <a href="#luzon" class="region-label label-luzon">LUZON</a>
                <a href="#visayas" class="region-label label-visayas">VISAYAS</a>
                <a href="#mindanao" class="region-label label-mindanao">MINDANAO</a>
            </div>
        </section>
    </main>
</body>
</html>
